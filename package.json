{
  "name": "smarttakeoff",
  "productName": "SmartTakeoff",
  "version": "0.5.0",
  "description": "Takeoff de planos PDF con mediciones mecánicas, despiece y exportación a Excel",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:dir": "electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.smarttakeoff.app",
    "productName": "SmartTakeoff",
    "files": ["index.html", "manifest.webmanifest", "icons/**", "lib/**", "electron/**"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "artifactName": "SmartTakeoff-Setup.${ext}", "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "SmartTakeoff" },
    "fileAssociations": [{ "ext": "takeoff", "name": "SmartTakeoff project", "role": "Editor" }]
  }
}
